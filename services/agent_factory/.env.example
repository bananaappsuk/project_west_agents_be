SERVICE_NAME=agent_factory
ENV=dev
AUTH_ISSUER=https://auth.platform.local
AUTH_JWKS_URL=http://localhost:8001/.well-known/jwks.json

# The factory's own Neon database (LangGraph checkpoints + per-agent vector collections).
# Reusing neondb for now is fine; give it its own DB later.
DATABASE_URL=postgresql+asyncpg://neondb_owner:PASSWORD@ep-odd-wildflower-awi7bebh-pooler.c-12.us-east-1.aws.neon.tech/neondb

# LLM provider (OpenAI). A placeholder key ("dummy") runs the agent in stub mode;
# a real sk-... key switches it to live LLM calls automatically.
OPENAI_API_KEY=dummy
OPENAI_MODEL=gpt-4o-mini
CONFIDENCE_THRESHOLD=0.6

# Shared secret for internal service-to-service calls (west-agent cron -> factory).
# Must match west-agent's AGENT_FACTORY_INTERNAL_KEY. Leave unset to require user JWTs only.
INTERNAL_API_KEY=dev-internal-key-change-me
