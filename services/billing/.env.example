SERVICE_NAME=billing
ENV=dev
AUTH_ISSUER=https://auth.platform.local
AUTH_JWKS_URL=http://localhost:8001/.well-known/jwks.json

# Billing's own Neon database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/billing

# Must match Auth's BILLING_INTERNAL_KEY (see backend/services/auth/.env.example) —
# lets Auth create a trial Subscription right after register() without a user JWT.
INTERNAL_API_KEY=dev-internal-key-change-me

# Use TEST-mode keys (sk_test_.../whsec_...) for local dev — never a live key.
# Get these from your own Stripe account's dashboard, in test mode.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Where Checkout/Portal should redirect back to.
FRONTEND_URL=http://localhost:3000

TRIAL_DAYS=14
