SERVICE_NAME=voice_agent
ENV=dev
AUTH_ISSUER=https://auth.platform.local
AUTH_JWKS_URL=http://localhost:8001/.well-known/jwks.json
APP_KEY=voice-agent

# The voice-agent's database. Project West runs this on the SAME database as the
# mail agent and auth: the four voice tables (recordings, voice_settings,
# voice_notifications, voice_agent_runs) are namespaced and share no name with
# mail's 14 or auth's 9, so they coexist without collision.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME

# Fernet key. No longer used for the recording source, whose credentials now come
# from the variables below rather than from an encrypted database column. Still
# required because app/crypto.py is imported at startup.
ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# Agent Factory (voice/call agent) — internal key must match the factory's INTERNAL_API_KEY
AGENT_FACTORY_URL=http://localhost:8002
AGENT_FACTORY_INTERNAL_KEY=dev-internal-key-change-me

# Speech-to-text for LIVE BT Cloud recordings (audio -> transcript) via the OpenAI
# transcription API. Only needed once a BT Cloud JWT is configured; demo mode ignores it.
#OPENAI_API_KEY=sk-...
TRANSCRIBE_MODEL=whisper-1

# ── Recording source ────────────────────────────────────────────────────────
# Where call recordings come from. Configured here, not in the database and not in
# the UI: Project West points this at one phone system once and it does not change
# at runtime. app/source_config.py is the only place these are read.
#
# ⚠️ All four RC_* values are required TOGETHER. With a server URL but no JWT,
# bt_client serves DEMO recordings instead of failing, so a half-configured
# deployment would quietly store fabricated calls that look real once written. The
# agent therefore refuses to sync unless the set is complete, and
# GET /voice/settings reports exactly which variable is missing.

VOICE_SOURCE_TYPE=bt_cloud        # bt_cloud | s3

# BT Cloud Work / RingCentral — server-to-server JWT auth.
# Create the app at https://developers.ringcentral.com with the "JWT auth flow"
# grant and Read Call Log + Read Call Recording permissions.
RC_SERVER_URL=https://platform.ringcentral.com
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=

# S3-compatible bucket (AWS S3, Backblaze B2, MinIO, Cloudflare R2). Only read when
# VOICE_SOURCE_TYPE=s3. S3_ENDPOINT blank means AWS; S3_PREFIX is optional.
#S3_ENDPOINT=
#S3_REGION=eu-west-2
#S3_BUCKET=
#S3_PREFIX=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=

# Background scheduler. CRON_ENABLED is the master switch; the tick checks whether
# a run is due against VOICE_CRON_FREQUENCY.
CRON_ENABLED=true
CRON_TICK_MINUTES=5
FETCH_PER_RUN=12
VOICE_CRON_FREQUENCY=every6h      # hourly | every6h | daily
VOICE_CRON_TIME=02:00             # HH:mm, used only by "daily"

# Logging verbosity: DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# CRM intake (pw-crm-be) — referrals, case communications, and session reschedule/cancel
# requests detected in calls are forwarded here. Off by default; set CRM_ENABLED=true
# once real credentials are configured, or every fetch will otherwise skip CRM entirely.
CRM_ENABLED=false
CRM_BASE_URL=http://localhost:8000/api/v1
CRM_CLIENT_ID=projectwest-voice-agent
CRM_API_KEY=CHANGE_ME_the_secret_half_of_this_client_id_in_pw-crm-be_INTAKE_CLIENTS
