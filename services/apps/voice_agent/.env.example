SERVICE_NAME=voice_agent
ENV=dev
AUTH_ISSUER=https://auth.platform.local
AUTH_JWKS_URL=http://localhost:8001/.well-known/jwks.json
APP_KEY=voice-agent

# voice-agent's own database (reusing neondb is fine — its tables are separate from mail's)
DATABASE_URL=postgresql+asyncpg://neondb_owner:PASSWORD@HOST/neondb

# Fernet key for encrypting the stored BT Cloud client secret. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# Agent Factory (voice/call agent) — internal key must match the factory's INTERNAL_API_KEY
AGENT_FACTORY_URL=http://localhost:8002
AGENT_FACTORY_INTERNAL_KEY=dev-internal-key-change-me

# Billing — entitlement checks + usage metering before/after each analysis run.
# Leave BILLING_URL unset to skip billing entirely (pipeline runs unmetered).
# Internal key must match billing's INTERNAL_API_KEY.
BILLING_URL=http://localhost:8003
BILLING_INTERNAL_KEY=dev-internal-key-change-me

# Speech-to-text for LIVE BT Cloud recordings (audio -> transcript) via the OpenAI
# transcription API. Only needed once a BT Cloud JWT is configured; demo mode ignores it.
#OPENAI_API_KEY=sk-...
TRANSCRIBE_MODEL=whisper-1

# Background scheduler. CRON_ENABLED is the master switch; per-org frequency comes from
# the Settings page (VoiceSettings). The tick checks each org's schedule.
CRON_ENABLED=true
CRON_TICK_MINUTES=5
FETCH_PER_RUN=12

# Logging verbosity: DEBUG | INFO | WARNING
LOG_LEVEL=INFO
