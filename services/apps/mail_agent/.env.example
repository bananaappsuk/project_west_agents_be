SERVICE_NAME=mail_agent
ENV=dev
AUTH_ISSUER=https://auth.platform.local
AUTH_JWKS_URL=http://localhost:8001/.well-known/jwks.json
APP_KEY=mail-agent

# mail-agent's own Neon database (reusing neondb for now is fine)
DATABASE_URL=postgresql+asyncpg://neondb_owner:PASSWORD@ep-odd-wildflower-awi7bebh-pooler.c-12.us-east-1.aws.neon.tech/neondb

# Fernet key for encrypting stored mailbox passwords. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# Agent Factory (mail agent) — internal key must match the factory's INTERNAL_API_KEY
AGENT_FACTORY_URL=http://localhost:8002
AGENT_FACTORY_INTERNAL_KEY=dev-internal-key-change-me

# Background scheduler. CRON_ENABLED is the master switch; per-org enable + interval
# come from the Settings page (AgentConfig). The tick checks each org's schedule.
CRON_ENABLED=true
CRON_TICK_MINUTES=5
FETCH_PER_RUN=20

# Logging verbosity for all services: DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# CRM intake (pw-crm-be) — referrals, case communications, and session reschedule/cancel
# requests detected in email are forwarded here. Off by default; set CRM_ENABLED=true
# once real credentials are configured, or every fetch will otherwise skip CRM entirely.
CRM_ENABLED=false
CRM_BASE_URL=http://localhost:8000/api/v1
CRM_CLIENT_ID=projectwest-email-agent
CRM_API_KEY=CHANGE_ME_the_secret_half_of_this_client_id_in_pw-crm-be_INTAKE_CLIENTS

# SendGrid — replaces raw SMTP for sending replies (see sendgrid_client.py).
# Required on Railway: it doesn't route outbound SMTP at all, so raw SMTP can
# never succeed there regardless of mailbox credentials. Leave unset to keep
# using raw SMTP (e.g. local dev, where it works fine).
# Sends as whichever mailbox address is configured in Settings (same as raw
# SMTP always did) — that address must be a Single Sender verified in the
# SendGrid dashboard, or sends are rejected. Reconfiguring the mailbox to a
# different address means re-verifying the new one in SendGrid too.
#SENDGRID_API_KEY=SG.xxxxxxxx
