SERVICE_NAME=auth
ENV=dev

# The auth service's own Neon database (asyncpg URL form)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/auth

# Token settings
AUTH_ISSUER=https://auth.platform.local
ACCESS_TOKEN_TTL=900          # 15 minutes
REFRESH_TOKEN_TTL=28800       # 8 hours, absolute from sign-in (rotation keeps the original expiry)
KEY_ID=auth-key-1

# Signing key. In the cloud, supply the RSA private key (PKCS8 PEM) here.
# Locally, leave unset and it is auto-generated into ./keys/private.pem (gitignored).
# PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Microsoft Entra ID sign-in (POST /auth/entra). The client id is the PW Agents SPA
# registration, which also exposes the API (api://<client-id>, scope access_as_user);
# access tokens must be v2 (requestedAccessTokenVersion=2), so their aud is the client id.
ENTRA_TENANT_ID=98b19873-116e-481c-8f5b-fd536f44f02c
ENTRA_CLIENT_ID=<client id>
#ENTRA_SCOPE=access_as_user
#ENTRA_MAX_TOKEN_AGE=300      # seconds

# Object id of the PW-Voice-Users Entra security group. Voice Agent entitlement is
# membership of this group plus an Agents app role; Email entitlement is the app
# role alone (see app/routers/entra.py::_entitled_apps). Voice has no internal
# roles and no per-recording permissions, so this one value is the whole of its
# access model.
#
# REQUIRED in every environment that should allow Voice access. Left unset, the
# service fails closed and nobody receives a Voice token -- which is deliberate:
# before this setting existed, every signed-in user was granted one automatically.
#
# ⚠️ Setting this is NOT sufficient on its own. The `groups` claim must also be
# enabled on the ENTRA_CLIENT_ID app registration, for ACCESS tokens -- otherwise
# no token carries group ids and Voice is denied to everyone. See the "Entra token
# configuration" note in app/routers/entra.py.
ENTRA_VOICE_GROUP_ID=<PW-Voice-Users object id>
