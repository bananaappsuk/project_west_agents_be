SERVICE_NAME=auth
ENV=dev

# The auth service's own Neon database (asyncpg URL form)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/auth

# Token settings
AUTH_ISSUER=https://auth.platform.local
ACCESS_TOKEN_TTL=900          # 15 minutes
REFRESH_TOKEN_TTL=2592000     # 30 days
KEY_ID=auth-key-1

# Signing key. In the cloud, supply the RSA private key (PKCS8 PEM) here.
# Locally, leave unset and it is auto-generated into ./keys/private.pem (gitignored).
# PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Self-serve signup (POST /auth/register creates a new org + owner). Disable in prod if invite-only.
BOOTSTRAP_ENABLED=true

# Billing service — register() starts a trial Subscription here right after
# provisioning. Leave BILLING_URL unset to skip this (registration still works).
BILLING_URL=http://localhost:8003
# Must match billing's INTERNAL_API_KEY.
BILLING_INTERNAL_KEY=dev-internal-key-change-me

# White-label display name for invite emails. Match the frontend's
# NEXT_PUBLIC_APP_NAME. Used as the email "From" name unless SMTP_FROM overrides it.
#APP_NAME=Acme Agent

# Invite email delivery (optional). Leave SMTP_HOST unset to skip emailing — invites
# are still created and the inviter shares the one-time /accept link manually.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=you@yourcompany.com
#SMTP_PASSWORD=your-app-password
#SMTP_FROM=Acme Agent <no-reply@yourcompany.com>
#SMTP_STARTTLS=true
