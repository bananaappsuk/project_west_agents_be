# Python
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
.env.local
*.env
# Timestamped copies taken before changing a DATABASE_URL. These hold the full
# connection string, password included, and none of the patterns above catch a
# name like `.env.backup-20261113-090845`. Same shape of gap as the signing key
# in DECISIONS.md D12: untracked and unignored, one `git add -A` from committed.
.env.backup*
*.env.backup*

# Keys (dev-generated signing keys)
keys/
*.pem
# The same keys in the single-line, backslash-escaped form that goes into
# PRIVATE_KEY_PEM (see services/auth/app/keys.py). These are .txt because they
# are meant to be pasted into an environment variable, so neither `*.pem` nor
# `keys/` catches them -- services/auth/private_key_pem.txt was sitting
# untracked and unignored, one `git add -A` from being committed.
*private_key*.txt
*private_key*.pem
*_key_pem*
*.key
# Exchange PowerShell session dump (tenant data, not source)
mail_output.txt
